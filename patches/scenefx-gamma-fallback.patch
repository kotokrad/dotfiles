diff --git a/render/fx_renderer/shaders/gamma_lut.frag b/render/fx_renderer/shaders/gamma_lut.frag
new file mode 100644
index 0000000..6ecdf64
--- /dev/null
+++ b/render/fx_renderer/shaders/gamma_lut.frag
@@ -0,0 +1,21 @@
+#extension GL_EXT_shader_framebuffer_fetch : require
+
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+precision highp float;
+#else
+precision mediump float;
+#endif
+
+uniform sampler2D lut; // 256x1, one entry per 8-bit channel value
+
+void main() {
+	// The pixel being overwritten. On tiling GPUs it's still in tile memory
+	vec4 c = gl_LastFragData[0];
+	// Centre of texel k for channel value k/255
+	vec3 s = (c.rgb * 255.0 + 0.5) / 256.0;
+	gl_FragColor = vec4(
+		texture2D(lut, vec2(s.r, 0.5)).r,
+		texture2D(lut, vec2(s.g, 0.5)).g,
+		texture2D(lut, vec2(s.b, 0.5)).b,
+		c.a);
+}
