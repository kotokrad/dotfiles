index 39b6226..93b5e22 100644
--- a/render/fx_renderer/fx_pass.c
+++ b/render/fx_renderer/fx_pass.c
@@ -1290,6 +1290,65 @@ done:
 	pixman_region32_fini(&region);
 }
 
+void fx_render_pass_apply_gamma_lut(struct fx_gles_render_pass *pass,
+		pixman_region32_t *region, struct wlr_color_transform *tr) {
+	struct fx_renderer *renderer = pass->buffer->renderer;
+	if (!renderer->exts.EXT_shader_framebuffer_fetch || !pixman_region32_not_empty(region)) {
+		return;
+	}
+
+	push_fx_debug(renderer);
+
+	if (renderer->gamma_lut_tr != tr) {
+		GLubyte lut[256 * 4];
+		for (int i = 0; i < 256; i++) {
+			const float in[3] = { i / 255.0f, i / 255.0f, i / 255.0f };
+			float out[3];
+			wlr_color_transform_eval(tr, out, in);
+			for (int c = 0; c < 3; c++) {
+				lut[i * 4 + c] = roundf(fminf(fmaxf(out[c], 0.0f), 1.0f) * 255.0f);
+			}
+			lut[i * 4 + 3] = 255;
+		}
+		if (renderer->gamma_lut_tex == 0) {
+			glGenTextures(1, &renderer->gamma_lut_tex);
+		}
+		glActiveTexture(GL_TEXTURE0);
+		glBindTexture(GL_TEXTURE_2D, renderer->gamma_lut_tex);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, 256, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE, lut);
+		// The ref keeps the pointer from being reused for a different LUT
+		wlr_color_transform_unref(renderer->gamma_lut_tr);
+		renderer->gamma_lut_tr = wlr_color_transform_ref(tr);
+	}
+
+	struct gamma_lut_shader *shader = &renderer->shaders.gamma_lut;
+	struct wlr_box box = {
+		.width = pass->buffer->buffer->width,
+		.height = pass->buffer->buffer->height,
+	};
+
+	// Same buffer the frame was just drawn into, so no render pass split
+	fx_framebuffer_bind(pass->buffer);
+	glDisable(GL_BLEND);
+	glDisable(GL_STENCIL_TEST);
+	glUseProgram(shader->program);
+
+	glActiveTexture(GL_TEXTURE0);
+	glBindTexture(GL_TEXTURE_2D, renderer->gamma_lut_tex);
+	glUniform1i(shader->lut, 0);
+	set_proj_matrix(shader->proj, pass->projection_matrix, &box);
+
+	render(&box, region, shader->pos_attrib);
+
+	glBindTexture(GL_TEXTURE_2D, 0);
+
+	pop_fx_debug(renderer);
+}
